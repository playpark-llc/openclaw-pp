#!/usr/bin/env bash
#
# oc - OpenClaw CLI wrapper
#
# Runs OpenClaw CLI commands via Docker Compose.
# Usage: ./scripts/oc <command> [args...]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"

cd "${PROJECT_DIR}"
exec docker compose --profile cli run --rm openclaw-cli "$@"
